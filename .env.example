# ---- Runtime ----
RUNTIME_ID=local-dev
WORKSPACE_ROOT=./
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Auth ----
# Map each user id to a bearer token. Pair format: <userId>:<token>,<userId>:<token>
LOCAL_USER_TOKENS=usr_dev00000000000000000:dev-token

# ---- Web client ----
NEXT_PUBLIC_RUNTIME_URL=http://localhost:4000
NEXT_PUBLIC_BEARER=dev-token

# ---- LLM (MessageGuard adapter) ----
# Provider: anthropic | openai | heuristic (default: heuristic — zero-config offline).
LLM_PROVIDER=heuristic
LLM_MODEL=claude-opus-4-7
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=15000

# ---- Retry ----
RUNTIME_RETRY_POLL_MS=5000

# ---- SSE ----
RUNTIME_SSE_ACK_INTERVAL_MS=10000
RUNTIME_SSE_ACK_TIMEOUT_MS=30000
RUNTIME_SSE_REPLAY_BUFFER_EVENTS=1000
RUNTIME_SSE_REPLAY_BUFFER_EVENTS_WITH_TEAM=2000
RUNTIME_SSE_REPLAY_MAX_AGE_S=600

# ---- Events JSONL rotation ----
RUNTIME_EVENTS_JSONL_MAX_BYTES=67108864
RUNTIME_EVENTS_JSONL_MAX_AGE_DAYS=30

# ---- Notify ----
RUNTIME_NOTIFY_GLOBAL_RPM=30

# ---- Team ----
RUNTIME_TEAM_RECLAIM_SCAN_MS=10000

# ---- Feishu channel (optional; enables HMAC verify when encrypt key set) ----
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
