  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Row 1 — Retry scheduling rate",
      "type": "row"
    },
    {
      "id": 1,
      "title": "task_retry_scheduled_total — per-minute rate by failureClass",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "retries / min",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum by (failureClass) (rate(task_retry_scheduled_total{instance=~\"$instance\"}[1m])) * 60",
          "legendFormat": "{{failureClass}}",
          "range": true,
          "refId": "A"
        }
      ],
      "alert": {
        "name": "Retry storm: transient_error rate exceeds 10/min",
        "conditions": [
          {
            "evaluator": { "params": [10], "type": "gt" },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "params": [], "type": "avg" },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "5m",
        "frequency": "1m",
        "handler": 1,
        "noDataState": "no_data",
        "notifications": [],
        "annotations": {
          "summary": "Retry storm: transient_error rate exceeds 10/min",
          "runbook_url": "https://github.com/ai-workflow/my-space/blob/main/docs/runbooks/retry-troubleshooting.md#sop-1-retry-%E9%A3%8E%E6%9A%B4-transient_error-retry-storm",
          "severity": "warning"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
