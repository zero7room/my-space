{
  "annotations": {
    "list": []
  },
  "title": "AI Workflow — Runtime",
  "uid": "ai-workflow-runtime",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Tasks completed (5m rate)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(ai_task_completed_total[5m])" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "stat",
      "title": "Tasks failed (5m rate)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(ai_task_failed_total[5m])" }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Tool call duration p95 by tool",
      "datasource": "prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(ai_tool_call_duration_ms_bucket[5m])))"
        }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },
    {
      "type": "graph",
      "title": "Channel outbound by status",
      "datasource": "prometheus",
      "targets": [
        { "expr": "rate(ai_channel_outbound_total[5m])" }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 }
    }
  ],
  "schemaVersion": 36
}
