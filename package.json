{
  "name": "ai-workflow-system",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @ai-workflow/bot-runtime --filter @ai-workflow/web dev",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ai-workflow/bot-runtime test:e2e && pnpm --filter @ai-workflow/web test:e2e",
    "test:evals": "pnpm --filter @ai-workflow/bot-runtime test:evals",
    "verify": "pnpm lint && pnpm -r build && pnpm -r test && pnpm test:evals"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  }
}
